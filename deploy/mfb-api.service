# /etc/systemd/system/mfb-api.service
[Unit]
Description=Mundo Meu Filho Bilíngue — API
After=network.target

[Service]
User=mfb
WorkingDirectory=/opt/mfb-interactive/app
Environment=NODE_ENV=production
Environment=DB_PATH=/var/lib/mfb/app.db
Environment=PORT=8787
ExecStart=/usr/bin/node server/src/main.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mfb

[Install]
WantedBy=multi-user.target
