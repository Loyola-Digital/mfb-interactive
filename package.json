{
  "name": "mfb-interactive",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "vite web",
    "dev:server": "node --watch server/src/main.ts --dev",
    "build": "vite build web",
    "start": "node server/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "conta:criar": "node server/src/cli.ts criar",
    "conta:senha": "node server/src/cli.ts senha",
    "conta:desativar": "node server/src/cli.ts desativar"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
